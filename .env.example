# Copy to .env (deployment) or .env.local (development). Never commit real values.

# Where /bridge/eeg is forwarded: an EEG bridge that speaks docs/EEG-BRIDGE-PROTOCOL.md.
EEG_BRIDGE_UPSTREAM=http://eeg-bridge.example:8080

# Build switches ------------------------------------------------------------
# 1 shows the Input tab (EEG bridge, demo signals, reactivity). Off by default and on the public site.
FEATURE_INPUT=0

# Usage counting (public site only; see src/analytics.ts). Leave unset everywhere else.
# VITE_ANALYTICS_SRC=https://stats.example/script.js
# VITE_ANALYTICS_ID=

# Deployment only -----------------------------------------------------------
# Host ports for plain http and for https.
HTTP_PORT=8080
HTTPS_PORT=8443
# The https address people will type, including the port above, and its host part alone.
TLS_SITE=https://sensory.example:8443
TLS_HOST=sensory.example
