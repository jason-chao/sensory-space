# Copy to .env (deployment) or .env.local (development). Never commit real values.

# Where /bridge/eeg is forwarded: the EEG bridge.
EEG_BRIDGE_UPSTREAM=http://eeg-bridge.example:8080

# Deployment only -----------------------------------------------------------
# Host ports for plain http and for https.
HTTP_PORT=8080
HTTPS_PORT=8443
# The https address people will type, including the port above, and its host part alone.
TLS_SITE=https://sensory.example:8443
TLS_HOST=sensory.example
